  "check_definitions": {
    "ledger_vs_bank_total_match": {
      "name": "Ledger vs Bank Cleared Match",
      "tool": "get_checksum_totals",
      "description": "Compares ledger debits/credits total to bank cleared settlement amount",
      "target_asset": "reconciliation_table",
      "comparison": "equal",
      "tolerance": 0.00,
      "severity_on_fail": "CRITICAL"
    },
    "settlement_file_row_count": {
      "name": "Settlement Batch Ingestion Count",
      "tool": "compare_to_baseline",
      "description": "Verifies inbound cleared batch count against trailing 30-day baseline average (12,500 rows +/- 10%)",
      "target_asset": "bank_settlement_feed",
      "max_drop_percentage": 15.0,
      "severity_on_fail": "CRITICAL"
    },
    "settlement_arrival_freshness": {
      "name": "Settlement File SLA Freshness",
      "tool": "get_freshness",
      "description": "Checks if settlement batch arrived within standard SLA window (<60 min)",
      "target_asset": "bank_settlement_feed",
      "max_lag_minutes": 60,
      "severity_on_fail": "MEDIUM"
    },
    "duplicate_payment_keys": {
      "name": "Payment Key Uniqueness",
      "tool": "get_duplicate_stats",
      "description": "Verifies that no payment UUIDs or settlement references have been duplicated",
      "target_asset": "payment_ledger",
      "max_allowed_duplicate_rate": 0.0,
      "severity_on_fail": "HIGH"
    },
    "dashboard_refresh_freshness": {
      "name": "Treasury Dashboard SLA Freshness",
      "tool": "get_freshness",
      "description": "Verifies that Metabase liquidity aggregations refreshed within the 15-minute SLA window.",
      "target_asset": "settlement_dashboard",
      "max_lag_minutes": 15,
      "severity_on_fail": "HIGH"
    },
    "dashboard_scheduler_health": {
      "name": "Treasury Cube Scheduler Health",
      "tool": "get_job_status",
      "description": "Checks orchestrator status and exit code for the metabase_cube_refresh container.",
      "target_asset": "settlement_dashboard",
      "severity_on_fail": "MEDIUM"
    },
    "regulatory_extract_sla": {
      "name": "Compliance Batch SLA Freshness",
      "tool": "get_freshness",
      "description": "Checks that the RBI / FinCEN batch extract builder generated daily regulatory ledger proofs.",
      "target_asset": "regulatory_extract",
      "max_lag_minutes": 120,
      "severity_on_fail": "CRITICAL"
    },
    "regulatory_seal_integrity": {
      "name": "Cryptographic Audit Seal Validation",
      "tool": "get_job_status",
      "description": "Verifies that the rbi_fincen_batch_builder produced valid cryptographic audit seal hashes.",
      "target_asset": "regulatory_extract",
      "severity_on_fail": "CRITICAL"
    }
  },
  "severity_rules": {
    "CRITICAL": {
      "level": "CRITICAL",
      "urgency": "PAGE_IMMEDIATELY",
      "criteria": "Direct financial break > $10,000, broken ledger balance, or regulatory window deadline < 2h.",
      "escalation_target": "Sarah Chen & Marcus Vance",
      "fire_intensity": "HIGH"
    },
    "HIGH": {
      "level": "HIGH",
      "urgency": "PAGE_NOW",
      "criteria": "Duplicate keys detected or financial mismatch between $1,000 and $10,000.",
      "escalation_target": "Alex Rivera",
      "fire_intensity": "MEDIUM"
    },
    "MEDIUM": {
      "level": "MEDIUM",
      "urgency": "NOTIFY_NEXT_HOUR",
      "criteria": "Late arrival of non-critical batch or upstream latency warning.",
      "escalation_target": "Recon Ops Queue",
      "fire_intensity": "LOW"
    }
  }
}
